<resources>

    <style name="AppThemeDay" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:buttonStyle">@style/ButtonStyleDay</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="AppThemeNight" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:buttonStyle">@style/ButtonStyleNight</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="ButtonStyleDay" parent="android:style/Widget.Material.Button">
        <item name="android:background">@drawable/button_style_light</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">#493126</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="ButtonStyleNight" parent="android:style/Widget.Material.Button">
        <item name="android:background">@drawable/button_style_dark</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textAllCaps">false</item>
    </style>

</resources>